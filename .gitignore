# -------------------------------------------------------------------
# 3. TEMPORARY SOURCE CACHES (Full Delete)
# Folders created in 'vendor/' and then deleted by depinit_client.py.
# -------------------------------------------------------------------
/vendor/stb/*
/vendor/pcg-cpp/*
/vendor/argparse/*
/vendor/miniaudio/*
/vendor/rapidjson/*
/vendor/wil/*

# -------------------------------------------------------------------
# 4. KEPT SUBMODULES (Ignore Contents / Track Pointer)
# Tracks the vendor folder, but ignores all source files inside (recursively).
# -------------------------------------------------------------------
/vendor/cryptopp/src/*
/vendor/mio/*
/vendor/zstd/*
/vendor/lzo-2.10/include/lzo/*
/vendor/lzo-2.10/src/*
/vendor/DirectXMath/*

# -------------------------------------------------------------------
# 5. ESSENTIAL EXEMPTIONS (Track these specific files/folders)
# The '!' only works if a parent folder was aggressively ignored (like /vendor/*), 
# but they are kept here for the essential files that MUST be committed to your main repo.
# -------------------------------------------------------------------
!/vendor/lzo-2.10/include/lzo/
!/vendor/lzo-2.10/src/
!/vendor/lzo-2.10/CMakeLists.txt
!/vendor/CMakeLists.txt
!/vendor/cryptopp/CMakeLists.txt
